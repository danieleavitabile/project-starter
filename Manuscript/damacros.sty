% NOTE: \AddToHook{env/.../begin}{\crefalias{theorem}{...}} below depends on
% the LaTeX kernel's generic environment-hook support, which is only
% reliable on a sufficiently recent kernel/distribution, and only remaps the
% *currently active* alias for the shared "theorem" counter -- it does not
% attach to any one label in particular. For a document where getting
% \cref/\Cref right really matters (e.g. a response to referees), prefer
% tagging each label explicitly instead, independently of this hook:
% \label[hypothesis]{...}, \label[assumption]{...}, \label[remark]{...},
% \label[claim]{...}. Note also that remark and claim have no crefalias
% wiring at all below, so \cref to one of them may print "Theorem" instead
% of "Remark"/"Claim" unless you label it explicitly as above.
\AddToHook{env/hypothesis/begin}{\crefalias{theorem}{hypothesis}}
\AddToHook{env/assumption/begin}{\crefalias{theorem}{assumption}}


