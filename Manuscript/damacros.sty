% The SIAM class sets \marginparwidth to a mere .25in, far too narrow for a
% textwidth=6em todonotes box: notes and their coloured box overflow past the
% page edge instead of being clipped to a legible margin. Widen it before
% todonotes loads (matches the fix todonotes itself suggests when it warns
% "marginparwidth is less than 2cm").
\setlength{\marginparwidth}{2.2cm}
\RequirePackage[textwidth=6em] {todonotes}
\RequirePackage{cleveref}
\RequirePackage{xcolor}

% Define a warning sybol
\newcommand\Warning{%
 \makebox[1.4em][c]{%
 \makebox[0pt][c]{\raisebox{.1em}{\small!}}%
 \makebox[0pt][c]{\Large$\bigtriangleup$}}}%

